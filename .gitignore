# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.deepeval/

# Environments
.venv/
venv/
ENV/
env/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# OS generated files
.DS_Store
Thumbs.db

# OpenTofu / Terraform local state and working directories
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Factory-staged tasks and stacks. Staged here to test bench changes
# against real tasks; not source. Remove the ignore deliberately when
# a task is ready to go upstream.
/tasks/b-*/
/tf/b-*/
/tf/prebuilt/b-*/

# Harness run output
/results/
/runs/
/scratchpad/
